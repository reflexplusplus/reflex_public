include: "common.glx";

@Font Medium:
{
	path: "fonts/OpenSans/static/OpenSans/OpenSans-Regular.ttf";
	size: 12;
};

size: 128,40;

transition: 0.25;
render_pad: 8;

bg: 
Shadow(blur: 4; colour: 200; corner: 4),
Fill(colour: 200; corner: 4), 
Text(font: Medium; colour: 48; justify: center);

@State hover: 
{ 
	bg: 
	Shadow(blur: 4; colour: 200; corner: 4),
	Fill(colour: 192; corner: 4),
	Text(font: Medium; colour: 48; justify: center); 
};

@State selected:
{
	bg:
	Shadow(blur: 4; colour: 42,142,214; corner: 4),
	Fill(colour: 42,142,214; corner: 4), 
	Text(font: Medium; colour: 255; justify: center);
};
