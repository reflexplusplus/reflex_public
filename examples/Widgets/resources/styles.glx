include: "common.glx";

@Font Medium:
{
	path: "fonts/OpenSans/static/OpenSans/OpenSans-Regular.ttf";
	size: 12;
};

size: 768,512;
bg_colour: 246;

TabGroup:
{
	header:
	{
		align_content: center;
		size: 36;
		padding: 4;
		bg_colour: 230;
		tab:
		{
			margin: 2;
			padding: 10,0;
			bg: Fill(colour: 220; corner: 3), Text(font: Medium; value: &value; colour: 48; justify: center);
			@State selected: { bg: Fill(colour: 255; corner: 3), Text(font: Medium; value: &value; colour: 8; justify: center); };
		};
	};
	body: 
	{ 
		bg_colour: 246; 
		clip: true;
		animate: true;
	};
};

Panel:
{
	size: 0, 360;
	padding: 12;
	bg: Fill(colour: 255; corner: 4), Border(colour: 210; corner: 4);
};

Description:
{
	size: 0, 36;
	margin: 4,0,0,0;
	
	bg: 
	Fill(colour: 232; corner: 4);
	
	Paragraph:
	{
		bg:
		Text(font: Medium; indent: 8; colour: 96; justify: top_left; autofit: y; line_height: 1.5; overflow: wrap; value: &value);
	};
};
