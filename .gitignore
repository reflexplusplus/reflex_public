*.DS_Store
xcuserdata/
DerivedData/

# --- Others ---
/.vscode/
*.ignore

# Causes too much issues (like exceptions at startup about not finding the gradle project path))
**/.idea

*.wasm

.claude/*
!.claude/commands/
.codex-build/

# Python
__pycache__/
*.pyc

# Visual Studio resource cache
*.aps

# CMake/CLion build directories
cmake-build-*/

# Reflex
**/*.cache
/*.zip

# Version is the git tag; CI generates version.txt into release zips / export trees.
/version.txt
/reflex
/reflex.bat
/ReflexProjectCreator.bat
/ReflexProjectCreator.command

/tmp

# Specs and plans are working documents, kept locally and not committed.
docs/superpowers/

# Local build output for the command-line tools
build/tools/*/output/

# Local worktrees
.sdd-worktrees/
